{
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
